{
  "id": "starburst",
  "name": "Starburst",
  "description": "Radial rays from origin with alternating short and long arms.",
  "tags": ["radial", "polar"],
  "author": "@swiftner",
  "cols": 24, "rows": 1,
  "showFirst": false,
  "formulas": {
    "x": "x = cos(i * TAU / 24) * ({x:40} + (i mod 2) * {x:40})",
    "y": "y = sin(i * TAU / 24) * ({y:40} + (i mod 2) * {y:40})",
    "rotation": "rotation = i * 360 / 24"
  }
}
