{
  "id": "fountain",
  "name": "Fountain",
  "description": "Parabolic toss with gravity-like decay.",
  "tags": ["arc", "physics"],
  "author": "@swiftner",
  "cols": 24, "rows": 1,
  "formulas": {
    "x": "x = (t - 0.5) * 400",
