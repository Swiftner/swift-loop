{
  "id": "comet",
  "name": "Comet",
  "description": "Trail of shapes shrinking and fading behind a head — motion frozen in place.",
  "tags": ["linear", "scale", "wave"],
  "author": "@swiftner",
  "cols": 32, "rows": 1,
  "formulas": {
    "x": "x = c * {x:18}",
    "y": "y = sin(t * PI * 0.6) * 20",
    "scaleX": "scaleX = -t * w * 0.8",
    "scaleY": "scaleY = -t * h * 0.8",
    "opacity": "opacity = 100 - t * 90"
  }
}
